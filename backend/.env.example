# Copy to .env.dev and fill in. Required = no default in app/core/config.py.

# --- Storage (required) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/symptora
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT_SECRET required) ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Medplum FHIR (required) — app.medplum.com > Project > Client applications ---
MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
MEDPLUM_PROJECT_ID=

# --- Cloudflare R2 for avatars / clinic & blog images (required) ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Google Calendar for appointment Meet links (required) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Email: OTPs, invites, consultation alerts ---
# Brevo HTTPS API is used when set (Render's free tier blocks SMTP); else SMTP.
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
INVITE_FROM_EMAIL=
FRONTEND_URL=http://localhost:5173

# --- Telemedicine payment — empty keys = simulated gateway (dev only) ---
TELEMEDICINE_FEE=499
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Deployment ---
CORS_ORIGINS=
RENDER_EXTERNAL_URL=
