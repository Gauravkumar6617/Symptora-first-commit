# Base URL of the FastAPI backend, reachable from the device/emulator.
# Use your machine's LAN IP for a physical device, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.5:8000

# Base URL of the deployed web client, for the video-call handoff (opened in
# the in-app browser). Defaults to the production site if unset.
EXPO_PUBLIC_WEB_URL=https://symptora-ten.vercel.app
